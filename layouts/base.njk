<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "components/seo.njk" %}
  <link rel="stylesheet" href="{{ '/css/site.css' | url }}">
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} · RSS" href="{{ '/feed.xml' | url }}">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main">跳到正文</a>
  {% include "components/site-header.njk" %}
  <main id="main">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>
  {% include "components/site-footer.njk" %}
  {% include "components/analytics.njk" %}
  {% block scripts %}{% endblock %}
</body>
</html>
