<article class="post-row">
  <time class="post-row__date" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
  <div class="post-row__body">
    <h3 class="post-row__title"><a href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
    <p class="post-row__summary">{{ post.data.summary }}</p>
    {% set tags = post.data.tags %}
    {% include "components/tag-list.njk" %}
  </div>
</article>
